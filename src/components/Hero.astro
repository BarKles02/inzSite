---
---

<section class="hero">
	<div class="container">
		<div class="hero-copy">
			<span class="eyebrow">Usługi inżynierskie</span>
			<h1>Precyzyjna inżynieria od pomysłu do gotowego elementu</h1>
			<p>
				Projektujemy, drukujemy w 3D i wykonujemy zindywidualizowane
				rozwiązania techniczne — od pojedynczego prototypu po lampy i
				elementy wykończone pod klucz.
			</p>
			<div class="hero-actions">
				<a href="#uslugi" class="btn btn-secondary">Zobacz usługi</a>
				<a href="#kontakt" class="btn btn-primary">Skontaktuj się</a>
			</div>
		</div>

		<div class="hero-graphic" aria-hidden="true">
			<svg viewBox="0 0 400 400" fill="none">
				<rect x="10" y="10" width="380" height="380" rx="4" stroke="#9CAFC0" stroke-width="1" stroke-dasharray="4 6" />
				<circle cx="200" cy="200" r="150" stroke="#9CAFC0" stroke-width="1" />

				<g stroke="#55BDF2" stroke-width="18" stroke-linecap="square">
					<line x1="120" y1="90" x2="120" y2="310" />
					<line x1="120" y1="200" x2="280" y2="90" />
					<line x1="120" y1="200" x2="280" y2="310" />
				</g>

				<g stroke="#08141F" stroke-width="1" opacity="0.5">
					<line x1="40" y1="60" x2="80" y2="60" />
					<line x1="60" y1="40" x2="60" y2="80" />
					<line x1="320" y1="330" x2="360" y2="330" />
					<line x1="340" y1="310" x2="340" y2="350" />
				</g>

				<g stroke="#FF8A24" stroke-width="2">
					<line x1="200" y1="200" x2="200" y2="60" stroke-dasharray="3 5" />
					<circle cx="200" cy="60" r="4" fill="#FF8A24" stroke="none" />
				</g>
			</svg>
		</div>
	</div>
</section>
