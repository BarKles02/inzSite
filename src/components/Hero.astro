---
---

<section class="hero">
	<div class="hero-bg" aria-hidden="true"></div>
	<div class="container">
		<div class="hero-copy">
			<span class="eyebrow">Usługi inżynierskie</span>
			<h1>Precyzyjna inżynieria od pomysłu do gotowego elementu</h1>
			<p>
				Projektujemy, drukujemy w 3D i wykonujemy zindywidualizowane
				rozwiązania techniczne — od pojedynczego prototypu po lampy i
				elementy wykończone pod klucz.
			</p>
			<div class="hero-actions">
				<a href="#uslugi" class="btn btn-secondary">Zobacz usługi</a>
				<a href="#kontakt" class="btn btn-primary">Skontaktuj się</a>
			</div>
		</div>

		<div class="hero-graphic" aria-hidden="true">
			<svg viewBox="0 0 400 400" fill="none">
				<rect x="10" y="10" width="380" height="380" rx="4" stroke="#9CAFC0" stroke-width="1" stroke-dasharray="4 6" />
				<circle cx="200" cy="200" r="150" stroke="#9CAFC0" stroke-width="1" />

				<g stroke="#08141F" stroke-width="1" opacity="0.5">
					<line x1="40" y1="60" x2="80" y2="60" />
					<line x1="60" y1="40" x2="60" y2="80" />
					<line x1="320" y1="330" x2="360" y2="330" />
					<line x1="340" y1="310" x2="340" y2="350" />
				</g>

				<!-- printer frame -->
				<g stroke="#9CAFC0" stroke-width="3" stroke-linecap="round">
					<line x1="110" y1="70" x2="110" y2="300" />
					<line x1="290" y1="70" x2="290" y2="300" />
				</g>
				<rect x="120" y="290" width="160" height="10" rx="2" fill="#08141F" />

				<!-- printed object, layer by layer -->
				<rect class="print-layer print-layer-1" x="140" y="270" width="120" height="20" fill="#55BDF2" />
				<rect class="print-layer print-layer-2" x="148" y="250" width="104" height="20" fill="#55BDF2" />
				<rect class="print-layer print-layer-3" x="156" y="230" width="88" height="20" fill="#55BDF2" />
				<rect class="print-layer print-layer-4" x="164" y="210" width="72" height="20" fill="#55BDF2" />
				<rect class="print-layer print-layer-5" x="172" y="190" width="56" height="20" fill="#55BDF2" />
				<rect class="print-layer print-layer-6" x="180" y="170" width="40" height="20" fill="#55BDF2" />
				<rect class="print-layer print-layer-7" x="188" y="150" width="24" height="20" fill="#55BDF2" />

				<!-- print head -->
				<g class="printhead-y">
					<line x1="110" y1="270" x2="290" y2="270" stroke="#9CAFC0" stroke-width="3" />
					<g class="printhead-x">
						<path d="M200,254 l11,16 h-22 z" fill="#FF8A24" />
					</g>
				</g>
			</svg>
		</div>
	</div>
</section>
