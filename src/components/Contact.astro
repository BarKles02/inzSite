---
---

<section class="section contact-section" id="kontakt">
	<div class="container">
		<div class="section-header">
			<span class="eyebrow">Kontakt</span>
			<h2>Porozmawiajmy o Twoim projekcie</h2>
			<p>Wyślij zapytanie przez formularz lub skontaktuj się bezpośrednio.</p>
		</div>

		<div class="contact-grid">
			<div class="contact-details">
				<div class="contact-detail">
					<svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
						<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.1-8.6A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.3 1.8.6 2.7a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.4-1.4a2 2 0 0 1 2.1-.5c.9.3 1.8.5 2.7.6a2 2 0 0 1 1.8 2Z"/>
					</svg>
					<div>
						<a href="tel:+48000000000">+48 000 000 000</a>
						<p>Pon–Pt, 8:00–16:00 (dane do uzupełnienia)</p>
					</div>
				</div>

				<div class="contact-detail">
					<svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
						<path d="M4 4h16v16H4z"/><path d="m4 6 8 7 8-7"/>
					</svg>
					<div>
						<a href="mailto:kontakt@inz-kacperpachut.pl">kontakt@inz-kacperpachut.pl</a>
						<p>Odpowiadamy zwykle w ciągu 1–2 dni roboczych</p>
					</div>
				</div>

				<div class="contact-detail">
					<svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
						<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>
					</svg>
					<div>
						<address>Suwałki (dokładny adres do uzupełnienia)</address>
						<p>Realizacje na terenie całego kraju</p>
					</div>
				</div>
			</div>

			<form class="contact-form" aria-label="Formularz kontaktowy">
				<div class="form-field">
					<label for="name">Imię i nazwisko</label>
					<input type="text" id="name" name="name" autocomplete="name" required />
				</div>
				<div class="form-field">
					<label for="email">Adres e-mail</label>
					<input type="email" id="email" name="email" autocomplete="email" required />
				</div>
				<div class="form-field">
					<label for="message">Wiadomość</label>
					<textarea id="message" name="message" rows="5" required></textarea>
				</div>
				<button type="submit" class="btn btn-primary">Wyślij zapytanie</button>
			</form>
		</div>
	</div>
</section>
